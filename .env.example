# Optional overrides after deploy (Render Dashboard → anythingllm → Environment).
# Core vars (PORT, STORAGE_DIR, JWT_SECRET, SIG_KEY, SIG_SALT) are set by render.yaml.

# Instance-wide password gate (optional). Leave blank for single-admin UI login only.
# AUTH_TOKEN=

# LLM / embedding providers are usually configured in the AnythingLLM UI after first login.
# You can also inject keys via env if you prefer (examples):
# LLM_PROVIDER=openai
# OPEN_AI_KEY=
# OPEN_MODEL_PREF=gpt-4.1-nano

# Full list: https://docs.anythingllm.com/configuration
# Upstream docker env reference:
# https://github.com/Mintplex-Labs/anything-llm/blob/master/docker/.env.example
